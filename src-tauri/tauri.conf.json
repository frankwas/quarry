{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quarry",
  "version": "0.1.0",
  "identifier": "dev.quarry.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/quarry/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Quarry",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A modern desktop MySQL client",
    "longDescription": "Quarry is a fast, keyboard-friendly MySQL client: SQL editor with autocomplete, editable results, schema browser, table designer, ER diagrams, import/export, server admin and an AI assistant.",
    "publisher": "Francois Steyn",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}